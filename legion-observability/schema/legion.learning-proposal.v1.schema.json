{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion.local/schema/legion.learning-proposal.v1.schema.json",
  "title": "legion.learning-proposal.v1",
  "type": "object",
  "required": ["schema", "id", "repository_identity", "entity", "guidance", "status"],
  "properties": {
    "schema": {"const": "legion.learning-proposal.v1"},
    "id": {"type": "string", "minLength": 1},
    "repository_identity": {"type": "string", "minLength": 1},
    "entity": {"type": "string", "minLength": 1},
    "guidance": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["candidate", "approved", "rejected", "superseded"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
