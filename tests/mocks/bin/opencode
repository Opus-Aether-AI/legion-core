#!/usr/bin/env bash
# Mock opencode CLI. Emits a schema-accurate `--format json` JSONL EVENT STREAM
# (message.updated carrying AssistantMessage {cost, tokens:{input,output,
# reasoning,cache:{read,write}}}, message.part.updated text, session.idle) so the
# legion-opencode adapter's stream parsing can be tested deterministically.

set -euo pipefail
[[ -n "${MOCK_CALL_LOG:-}" ]] && printf 'opencode %s\n' "$*" >> "$MOCK_CALL_LOG"
[[ -n "${MOCK_CONTEXT_LOG:-}" ]] && printf 'opencode active=%s executor=%s depth=%s run=%s\n' \
  "${LEGION_ACTIVE:-}" "${LEGION_EXECUTOR:-}" "${LEGION_DEPTH:-}" "${LEGION_RUN_ID:-}" >> "$MOCK_CONTEXT_LOG"

model="fixture/opencode-model"
agent=""
# positional after `run`
[[ "${1:-}" == "run" ]] && shift
while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--model) model="$2"; shift 2 ;;
    --agent) agent="$2"; shift 2 ;;
    --variant) shift 2 ;;
    --format) shift 2 ;;
    --format=*) shift ;;
    *) shift ;;
  esac
done

if [[ "${MOCK_OPENCODE_FAIL:-0}" == "1" ]]; then
  printf 'mock opencode forced failure\n' >&2
  exit 4
fi

# OpenCode 1.3 can report provider failures as a JSONL error event while the
# process itself exits 0. The adapter must treat the event as authoritative.
if [[ "${MOCK_OPENCODE_ERROR_EVENT:-0}" == "1" ]]; then
  jq -cn '{type:"error",sessionID:"mock-session",error:{name:"APIError",data:{message:"The requested model is not supported.",statusCode:400,isRetryable:false}}}'
  exit 0
fi

[[ "${MOCK_OPENCODE_EMPTY_STREAM:-0}" != "1" ]] || exit 0

# Write a change unless running the non-writing plan agent (mirrors read-only).
if [[ "$agent" != "plan" || "${MOCK_OPENCODE_WRITE_IN_PLAN:-0}" == "1" ]]; then
  printf 'mock-opencode-change by %s\n' "$model" >> MOCK_OPENCODE_CHANGE.txt
  # Some agents branch and commit their own work. MOCK_OPENCODE_COMMITS
  # reproduces that so the adapter's diff can be tested against an executor
  # that leaves a clean working tree behind.
  if [[ "${MOCK_OPENCODE_COMMITS:-0}" == "1" ]]; then
    git checkout -q -b mock-opencode-branch 2>/dev/null || true
    git add -A 2>/dev/null || true
    git -c user.email=mock@example.com -c user.name=mock \
      commit -q -m "mock opencode commit" 2>/dev/null || true
  fi
fi

# Experimental plan mode writes its plan under .opencode/plans/ (output, not an edit).
if [[ "${MOCK_OPENCODE_WRITE_PLAN_FILE:-0}" == "1" ]]; then
  mkdir -p .opencode/plans
  printf '# plan by %s\n' "$model" >> .opencode/plans/plan.md
fi

provider="${model%%/*}"
modelid="${model#*/}"

if [[ "${MOCK_OPENCODE_CURRENT_STREAM:-0}" == "1" ]]; then
  jq -cn '{type:"step_start",sessionID:"mock-session",part:{id:"step-1",type:"step-start"}}'
  jq -cn '{type:"text",sessionID:"mock-session",part:{id:"text-1",type:"text",text:"partial"}}'
  jq -cn '{type:"text",sessionID:"mock-session",part:{id:"text-1",type:"text",text:"OPENCODE_CURRENT_OUTPUT"}}'
  jq -cn '{type:"step_finish",sessionID:"mock-session",part:{id:"finish-1",type:"step-finish",tokens:{total:343,input:300,output:40,reasoning:3,cache:{read:20,write:10}},cost:0.013}}'
  exit 0
fi

# Emit a stray non-JSON stdout line (e.g. a plugin console.log) to prove the
# adapter's tolerant parse skips it instead of zeroing the whole run's metering.
[[ "${MOCK_OPENCODE_STRAY_STDOUT:-0}" == "1" ]] && printf 'plugin: hello from console.log (not json)\n'

# Two streaming updates for one message id (take last state), plus a second
# assistant message id (sum across ids), plus text parts and session.idle.
cat <<EOF
{"type":"message.updated","properties":{"info":{"id":"u1","role":"user"}}}
{"type":"message.updated","properties":{"info":{"id":"a1","role":"assistant","providerID":"$provider","modelID":"$modelid","cost":0.002,"tokens":{"input":100,"output":10,"reasoning":0,"cache":{"read":0,"write":0}}}}}
{"type":"message.part.updated","properties":{"part":{"id":"p1","type":"text","text":"partial"}}}
{"type":"message.updated","properties":{"info":{"id":"a1","role":"assistant","providerID":"$provider","modelID":"$modelid","cost":0.005,"tokens":{"input":200,"output":50,"reasoning":5,"cache":{"read":20,"write":30}}}}}
{"type":"message.part.updated","properties":{"part":{"id":"p1","type":"text","text":"OPENCODE_OK_OUTPUT"}}}
{"type":"message.updated","properties":{"info":{"id":"a2","role":"assistant","providerID":"$provider","modelID":"$modelid","cost":0.002,"tokens":{"input":10,"output":5,"reasoning":0,"cache":{"read":0,"write":0}}}}}
{"type":"session.idle","properties":{}}
EOF
