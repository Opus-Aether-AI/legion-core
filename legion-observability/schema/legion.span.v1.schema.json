{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Opus-Aether-AI/legion-core/legion-observability/schema/legion.span.v1.schema.json",
  "title": "legion.span.v1",
  "description": "One unit of metered work by any Legion executor, using model roles resolved from the Legion catalog. Appended as JSONL to $LEGION_TELEMETRY_DIR/<date>.jsonl by legion-delegate, the runners, and legion-telemetry. Consumed by legion-aggregate / legion-report / legion-otel-export / legion-self-learn.",
  "type": "object",
  "required": ["schema", "ts", "run_id", "executor", "model", "status"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "legion.span.v1" },
    "ts": { "type": "string", "description": "ISO-8601 UTC timestamp" },
    "run_id": { "type": "string" },
    "attempt_id": { "type": ["string", "null"], "minLength": 1, "description": "Durable provider-attempt identity when this span represents one paid attempt." },
    "attempt_ordinal": { "type": ["integer", "null"], "minimum": 1, "description": "One-based provider-attempt ordinal within run_id." },
    "trace_id": { "type": ["string", "null"], "description": "groups spans of one multi-agent run; defaults to run_id" },
    "parent_id": { "type": ["string", "null"] },
    "executor": { "type": "string", "description": "codex | codex-review | claude | anthropic | minimax | ..." },
    "model": { "type": "string" },
    "archetype": { "type": ["string", "null"], "description": "Optional routing archetype used to select the executor/model." },
    "task": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "failed", "error", "over_budget", "blocked", "refused", "timed_out", "containment_failed"] },
    "target_type": { "type": ["string", "null"], "description": "Optional catalog entity type for self-learning attribution, e.g. plugin, skill, command, agent, hook, mcp." },
    "target_name": { "type": ["string", "null"], "description": "Optional catalog entity name for self-learning attribution." },
    "duration_ms": { "type": "number", "minimum": 0 },
    "cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "cost_status": { "type": "string", "enum": ["known", "partial", "unknown", "not_applicable"] },
    "known_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "known_cost_attempts": { "type": "integer", "minimum": 0 },
    "tokens": { "type": ["object", "null"] },
    "usage_status": { "type": "string", "enum": ["known", "partial", "unknown", "not_applicable"] },
    "known_usage": { "type": ["object", "null"] },
    "known_usage_attempts": { "type": "integer", "minimum": 0 },
    "artifacts": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "required": ["cost_status"], "properties": { "cost_status": { "const": "known" } } },
      "then": { "required": ["cost_usd"], "properties": { "cost_usd": { "type": "number" } } }
    },
    {
      "if": { "required": ["cost_status"], "properties": { "cost_status": { "enum": ["unknown", "not_applicable"] } } },
      "then": { "properties": { "cost_usd": { "type": "null" }, "known_cost_usd": { "type": "null" } } }
    },
    {
      "if": { "required": ["cost_status"], "properties": { "cost_status": { "const": "partial" } } },
      "then": {
        "required": ["cost_usd", "known_cost_usd", "known_cost_attempts"],
        "properties": { "cost_usd": { "type": "null" }, "known_cost_usd": { "type": "number" }, "known_cost_attempts": { "minimum": 1 } }
      }
    },
    {
      "if": { "required": ["usage_status"], "properties": { "usage_status": { "const": "known" } } },
      "then": { "required": ["tokens"], "properties": { "tokens": { "type": "object" } } }
    },
    {
      "if": { "required": ["usage_status"], "properties": { "usage_status": { "enum": ["unknown", "not_applicable"] } } },
      "then": { "properties": { "tokens": { "type": "null" }, "known_usage": { "type": "null" } } }
    },
    {
      "if": { "required": ["usage_status"], "properties": { "usage_status": { "const": "partial" } } },
      "then": {
        "required": ["tokens", "known_usage", "known_usage_attempts"],
        "properties": { "tokens": { "type": "null" }, "known_usage": { "type": "object" }, "known_usage_attempts": { "minimum": 1 } }
      }
    }
  ]
}
