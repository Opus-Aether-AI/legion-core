{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion.local/schema/legion.learning-law.v1.schema.json",
  "title": "legion.learning-law.v1",
  "type": "object",
  "required": ["schema", "key", "status", "confidence", "support", "evidence_ids", "guidance", "validation"],
  "properties": {
    "schema": {"const": "legion.learning-law.v1"},
    "key": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["candidate", "active", "retired"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "support": {
      "type": "object",
      "required": ["episodes", "projects"],
      "properties": {
        "episodes": {"type": "integer", "minimum": 0},
        "projects": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "guidance": {"type": "string", "minLength": 1},
    "validation": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
