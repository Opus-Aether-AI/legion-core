{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Opus-Aether-AI/legion-core/blob/main/legion-observability/schema/legion.convergence-checkpoint.v1.schema.json",
  "title": "legion.convergence-checkpoint.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "source_fingerprint", "checks", "review"],
  "properties": {
    "schema": {"const": "legion.convergence-checkpoint.v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_fingerprint": {"type": "string", "minLength": 1, "maxLength": 512},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "status", "evidence_fingerprint"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "scope": {"enum": ["local", "external"]},
          "status": {"enum": ["passed", "failed", "pending"]},
          "evidence_fingerprint": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_sha", "source_fingerprint", "blocking_findings", "suggestions"],
      "properties": {
        "head_sha": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "source_fingerprint": {"type": "string", "minLength": 1, "maxLength": 512},
        "blocking_findings": {"$ref": "#/$defs/findings"},
        "suggestions": {"$ref": "#/$defs/findings"}
      }
    }
  },
  "$defs": {
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint"],
        "properties": {
          "fingerprint": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
