#!/usr/bin/env bash
# Review-only, crash-resumable source-improvement engine.  Keep this shim small
# so installed PATH entries continue to work when the plugin is symlinked.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root="$(cd -P "$(dirname "$src")/.." >/dev/null 2>&1 && pwd)"
exec python3 "$root/scripts/legion-improve.py" "$@"
