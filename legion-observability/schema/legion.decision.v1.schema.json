{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion.local/schema/legion.decision.v1.schema.json",
  "title": "legion.decision.v1",
  "type": "object",
  "required": ["schema", "id", "event_id", "session_id", "episode_id", "project", "decision_type", "law_key", "confidence", "excerpt"],
  "properties": {
    "schema": {"const": "legion.decision.v1"},
    "id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "decision_type": {"type": "string", "enum": ["strategic_redirect", "product_insight", "technical_catch", "option_selection"]},
    "law_key": {"type": "string", "minLength": 1},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "excerpt": {"type": "string", "maxLength": 700},
    "matched_patterns": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
