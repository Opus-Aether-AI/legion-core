{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion.local/schema/legion.improvement-queue-run.v1.schema.json",
  "title": "legion.improvement-queue-run.v1",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "attempted",
    "failed",
    "skipped_completed",
    "invalid_entries",
    "quarantined",
    "results",
    "drafts_created"
  ],
  "properties": {
    "schema": {
      "const": "legion.improvement-queue-run.v1"
    },
    "mode": {
      "enum": [
        "off",
        "dry-run",
        "draft"
      ]
    },
    "attempted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "skipped_completed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "invalid_entries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "quarantined": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "state",
          "status"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "type": "string"
          },
          "status": {
            "enum": [
              "processed",
              "failed",
              "waiting"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "drafts_created": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    }
  },
  "additionalProperties": false
}
