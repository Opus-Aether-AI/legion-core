{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion.local/schema/legion.learning-hint.v1.schema.json",
  "title": "legion.learning-hint.v1",
  "type": "object",
  "required": ["schema", "id", "scope", "status", "trusted", "guidance"],
  "properties": {
    "schema": {"const": "legion.learning-hint.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "scope": {"type": "string", "enum": ["global", "selector", "exact"]},
    "status": {"type": "string", "enum": ["active", "retired", "superseded"]},
    "trusted": {"type": "boolean"},
    "guidance": {"type": "string", "minLength": 1, "maxLength": 40000},
    "entity": {"type": "string", "maxLength": 256},
    "stage": {"type": "string", "maxLength": 256},
    "selector": {
      "type": "object",
      "maxProperties": 3,
      "propertyNames": {"enum": ["repository_identity", "entity", "stage"]},
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1, "maxLength": 256},
          {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
        ]
      }
    },
    "evidence_ids": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 160}, "uniqueItems": true},
    "superseded_by": {"type": "string", "maxLength": 160},
    "expires_at": {"type": "string"}
  },
  "additionalProperties": true
}
