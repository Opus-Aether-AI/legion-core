#!/usr/bin/env bash
# Mock `codex` CLI for BATS — deterministic, offline, no ChatGPT auth needed.
#
# Behaviour controls (env):
#   MOCK_CALL_LOG   append "codex <args>" for assertions
#   MOCK_CODEX_FAIL =1 -> emit a thread.started then exit 3 (failure path)
#   MOCK_CODEX_REVIEW_FINDINGS=1 -> emit a request_changes verdict
#   MOCK_CODEX_REVIEW_EXIT=N -> write the verdict, then exit N (real Codex does
#     this when its prose does not satisfy --output-schema)
#   MOCK_CODEX_REVIEW_TRANSIENT_FAILS=N -> fail the first N review attempts
#   MOCK_CODEX_REVIEW_ATTEMPT_FILE=PATH -> persistent counter for transient failures
#   MOCK_CODEX_REVIEW_NO_VERDICT=1 -> review exits 0 without writing its verdict
#   MOCK_CODEX_REVIEW_INVALID_VERDICT=1 -> write a malformed review verdict
#   MOCK_CODEX_REVIEW_INVALID_VERDICTS=N -> malformed verdict for the first N
#     review attempts; MOCK_CODEX_REVIEW_INVALID_VERDICT_ATTEMPT_FILE=PATH
#     optionally supplies that attempt counter's persistent location
#   MOCK_CODEX_REVIEW_CONTRADICTORY=1 -> approve while reporting a blocking finding
#   MOCK_CODEX_REVIEW_UNPARSEABLE=1 -> write unrecognized prose instead of a verdict
#   MOCK_CODEX_REVIEW_MALFORMED_REJECT=1 -> a request_changes carrying a critical
#     finding that is schema-invalid only because the finding omits `title`
#   MOCK_CODEX_REVIEW_PRIORITY_PROSE=1 -> codex's prose review format with a [P1] marker
#   MOCK_CODEX_REVIEW_DELAY=N -> keep a review alive for signal-handling tests
#
# Emits the codex-cli 0.139.x --json event shape. For `exec` with a writable
# sandbox it creates a real file change in the -C worktree so `git diff` is
# non-empty. For `exec review` it returns a schema-valid verdict message.

set -euo pipefail
[[ -n "${MOCK_CALL_LOG:-}" ]] && printf 'codex %s\n' "$*" >> "$MOCK_CALL_LOG"
[[ -n "${MOCK_CONTEXT_LOG:-}" ]] && printf 'codex active=%s executor=%s depth=%s run=%s\n' \
  "${LEGION_ACTIVE:-}" "${LEGION_EXECUTOR:-}" "${LEGION_DEPTH:-}" "${LEGION_RUN_ID:-}" >> "$MOCK_CONTEXT_LOG"
[[ -n "${MOCK_ROUTE_ENV_LOG:-}" ]] && printf 'pre=%s executor=%s fallback=%s\n' \
  "${LEGION_ROUTE_PRE_RESOLVED:-}" "${LEGION_RESOLVED_EXECUTOR:-}" \
  "${LEGION_RESOLVED_FALLBACK:-}" >> "$MOCK_ROUTE_ENV_LOG"

args=("$@")
cd_dir="."; out_file=""; sandbox="read-only"; model="mock"; review=0; resume=0
i=0
while [[ $i -lt ${#args[@]} ]]; do
  case "${args[$i]}" in
    review)                     review=1 ;;
    resume)                     resume=1 ;;
    -C|--cd)                    i=$((i+1)); cd_dir="${args[$i]:-.}" ;;
    -o|--output-last-message)   i=$((i+1)); out_file="${args[$i]:-}" ;;
    -s|--sandbox)               i=$((i+1)); sandbox="${args[$i]:-read-only}" ;;
    -m|--model)                 i=$((i+1)); model="${args[$i]:-mock}" ;;
  esac
  i=$((i+1))
done

review_invalid_attempt=0
if [[ $review -eq 1 && "${MOCK_CODEX_REVIEW_INVALID_VERDICTS:-0}" =~ ^[0-9]+$ ]] &&
   [[ "${MOCK_CODEX_REVIEW_INVALID_VERDICTS:-0}" -gt 0 ]]; then
  invalid_counter="${MOCK_CODEX_REVIEW_INVALID_VERDICT_ATTEMPT_FILE:-${TMPDIR:-/tmp}/mock-codex-review-invalid-attempts}"
  [[ -f "$invalid_counter" ]] && read -r review_invalid_attempt < "$invalid_counter"
  review_invalid_attempt=$((review_invalid_attempt + 1))
  printf '%s\n' "$review_invalid_attempt" > "$invalid_counter"
fi

if [[ $review -eq 1 && "${MOCK_CODEX_REVIEW_TRANSIENT_FAILS:-0}" =~ ^[0-9]+$ ]] &&
   [[ "${MOCK_CODEX_REVIEW_TRANSIENT_FAILS:-0}" -gt 0 ]]; then
  review_counter="${MOCK_CODEX_REVIEW_ATTEMPT_FILE:-${TMPDIR:-/tmp}/mock-codex-review-attempts}"
  review_attempt=0
  [[ -f "$review_counter" ]] && read -r review_attempt < "$review_counter"
  review_attempt=$((review_attempt + 1))
  printf '%s\n' "$review_attempt" > "$review_counter"
  if [[ "$review_attempt" -le "$MOCK_CODEX_REVIEW_TRANSIENT_FAILS" ]]; then
    printf '%s\n' '{"type":"thread.started","thread_id":"mock-transient"}'
    printf '%s\n' '{"type":"turn.completed","usage":{"input_tokens":100,"cached_input_tokens":20,"output_tokens":5,"reasoning_output_tokens":1}}'
    printf 'mock codex review timed out\n' >&2
    exit 124
  fi
fi

# An executor with no quota never reviews at all. Exercises the reviewer
# fallback: delegate must move to the next candidate, not fail the review.
if [[ $review -eq 1 && -n "${MOCK_CODEX_REVIEW_QUOTA:-}" ]]; then
  printf "ERROR: You've hit your usage limit. Visit https://chatgpt.com/codex/settings/usage to purchase more credits.\n" >&2
  exit 1
fi

if [[ $review -eq 1 && -n "${MOCK_CODEX_REVIEW_CONTEXT_LOG:-}" ]]; then
  printf 'pwd=%s head=%s\n' "$PWD" "$(git rev-parse HEAD 2>/dev/null || true)" \
    >> "$MOCK_CODEX_REVIEW_CONTEXT_LOG"
fi

if [[ $review -eq 1 && -n "${MOCK_CODEX_REVIEW_DELAY:-}" ]]; then
  sleep "$MOCK_CODEX_REVIEW_DELAY" &
  delay_pid=$!
  [[ -n "${MOCK_CODEX_REVIEW_CHILD_PID_FILE:-}" ]] &&
    printf '%s\n' "$delay_pid" > "$MOCK_CODEX_REVIEW_CHILD_PID_FILE"
  wait "$delay_pid"
fi

if [[ "${MOCK_CODEX_FAIL:-}" == "1" ]]; then
  printf '%s\n' '{"type":"thread.started","thread_id":"mock-fail"}'
  printf 'mock codex forced failure\n' >&2
  exit 3
fi

[[ -n "${MOCK_CODEX_STDERR:-}" ]] && printf '%s\n' "$MOCK_CODEX_STDERR" >&2

# Simulate a quota/rate-limit failure for a specific model (to exercise the fallback chain).
if [[ -n "${MOCK_CODEX_QUOTA_FAIL:-}" && "$model" == "${MOCK_CODEX_QUOTA_FAIL}" ]]; then
  printf '%s\n' '{"type":"thread.started","thread_id":"mock-quota"}'
  printf 'Error: 429 rate limit exceeded — quota\n' >&2
  exit 1
fi

thread_id="mock-thread-0001"
printf '%s\n' '{"type":"thread.started","thread_id":"'"$thread_id"'"}'
printf '%s\n' '{"type":"turn.started"}'

if [[ $review -eq 1 ]]; then
  if [[ "${MOCK_CODEX_REVIEW_INVALID_VERDICT:-}" == "1" ]] ||
     [[ "$review_invalid_attempt" -le "${MOCK_CODEX_REVIEW_INVALID_VERDICTS:-0}" && "$review_invalid_attempt" -gt 0 ]]; then
    msg='{"verdict":"approve","summary":"mock invalid review","findings":[{}]}'
  elif [[ "${MOCK_CODEX_REVIEW_CONTRADICTORY:-}" == "1" ]]; then
    msg='{"verdict":"approve","summary":"mock contradictory review","findings":[{"severity":"critical","title":"Blocking issue"}]}'
  elif [[ "${MOCK_CODEX_REVIEW_MALFORMED_REJECT:-}" == "1" ]]; then
    msg='{"verdict":"request_changes","summary":"auth bypass","findings":[{"severity":"critical","detail":"missing authorization"}]}'
  elif [[ "${MOCK_CODEX_REVIEW_PRIORITY_PROSE:-}" == "1" ]]; then
    msg='- [P1] Missing authorization check — auth.py:42'
  elif [[ "${MOCK_CODEX_REVIEW_UNPARSEABLE:-}" == "1" ]]; then
    msg='Review completed without a structured verdict.'
  elif [[ "${MOCK_CODEX_REVIEW_FINDINGS:-}" == "1" ]]; then
    msg='{"verdict":"request_changes","summary":"mock blocking review","findings":[{"severity":"high","title":"Needs work"}]}'
  elif [[ "${MOCK_CODEX_REVIEW_PROSE:-}" == "1" ]]; then
    msg='No findings.'
  else
    msg='{"verdict":"approve","summary":"mock review","findings":[]}'
  fi
  printf '%s\n' '{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"'"$(printf '%s' "$msg" | sed 's/"/\\"/g')"'"}}'
else
  msg="Mock codex ($model) completed the task."
  # resume passes no -s (sandbox default read-only) but still edits the worktree.
  if [[ "$sandbox" == "workspace-write" || "$sandbox" == "danger-full-access" || $resume -eq 1 ]]; then
    printf 'mock-codex-change by %s\n' "$model" >> "$cd_dir/MOCK_CODEX_CHANGE.txt" 2>/dev/null || true
    if [[ "${MOCK_CODEX_PYCACHE:-}" == "1" ]]; then
      mkdir -p "$cd_dir/__pycache__" "$cd_dir/nested/__pycache__"
      printf 'pyc' > "$cd_dir/__pycache__/mock.cpython-312.pyc"
      printf 'pyc' > "$cd_dir/nested/__pycache__/mock.cpython-312.pyc"
    fi
  fi
  printf '%s\n' '{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"'"$msg"'"}}'
fi

printf '%s\n' '{"type":"turn.completed","usage":{"input_tokens":1000,"cached_input_tokens":200,"output_tokens":50,"reasoning_output_tokens":10}}'
if [[ -n "$out_file" ]]; then
  if [[ $review -ne 1 || "${MOCK_CODEX_REVIEW_NO_VERDICT:-}" != "1" ]]; then
    printf '%s\n' "$msg" > "$out_file"
  fi
fi
if [[ $review -eq 1 && -n "${MOCK_CODEX_REVIEW_EXIT:-}" ]]; then
  exit "$MOCK_CODEX_REVIEW_EXIT"
fi
exit 0
