#!/usr/bin/env python3
"""Test wrapper: fail only the broker-target supervisor with status 70."""

from __future__ import annotations

import os
import sys


arguments = sys.argv[1:]
if len(arguments) >= 2 and arguments[0] == "--cwd" and "runtime-root/repo" in arguments[1]:
    raise SystemExit(70)

real_supervisor = os.environ["MOCK_REAL_SUPERVISOR"]
os.execv(real_supervisor, [real_supervisor, *arguments])
