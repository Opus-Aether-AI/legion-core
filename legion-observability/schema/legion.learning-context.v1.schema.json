{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion.local/schema/legion.learning-context.v1.schema.json",
  "title": "legion.learning-context.v1",
  "type": "object",
  "required": ["schema", "repository_identity", "entity", "stage", "limits", "usage", "selected_hints", "excluded_hints"],
  "properties": {
    "schema": {"const": "legion.learning-context.v1"},
    "repository_identity": {"type": "string", "minLength": 1, "maxLength": 256},
    "entity": {"type": "string", "minLength": 1, "maxLength": 256},
    "stage": {"type": "string", "minLength": 1, "maxLength": 256},
    "limits": {
      "type": "object",
      "required": ["max_hints", "max_tokens"],
      "properties": {"max_hints": {"type": "integer", "minimum": 0, "maximum": 100}, "max_tokens": {"type": "integer", "minimum": 0, "maximum": 10000}},
      "additionalProperties": false
    },
    "usage": {"$ref": "legion.learning-usage.v1.schema.json"},
    "selected_hints": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "scope", "guidance", "selection_reason", "token_count"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 160},
          "scope": {"enum": ["global", "selector", "exact"]},
          "guidance": {"type": "string", "minLength": 1, "maxLength": 40000},
          "selection_reason": {"enum": ["global", "selector", "exact"]},
          "token_count": {"type": "integer", "minimum": 0, "maximum": 10000},
          "entity": {"type": "string", "minLength": 1, "maxLength": 256},
          "stage": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "additionalProperties": false
      }
    },
    "excluded_hints": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "exclusion_reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 160},
          "exclusion_reason": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
