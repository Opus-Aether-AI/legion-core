#!/usr/bin/env bash
# Mock for curl. Records calls and serves the marketplace fixture for install.sh
# tests that intentionally remove the local source clone.

set -euo pipefail

echo "curl $*" >> "${MOCK_CALL_LOG:-/dev/null}"

url="${!#}"
case "$url" in
    *"/releases/latest")
        # A private repository answers anonymous requests with 404, which curl
        # -f surfaces as exit 22 and no body. MOCK_RELEASE_REQUIRE_AUTH=1
        # reproduces that so the authenticated lookup can be tested.
        if [ "${MOCK_RELEASE_REQUIRE_AUTH:-0}" = "1" ] \
            && [[ "$*" != *"Authorization: Bearer "* ]]; then
            echo "mock curl: 404 (private repository, unauthenticated)" >&2
            exit 22
        fi
        if [ -n "${MOCK_RELEASE_RESPONSE:-}" ]; then
            printf '%s\n' "$MOCK_RELEASE_RESPONSE"
        else
            printf '{"tag_name":"%s","draft":false,"prerelease":false}\n' "${MOCK_RELEASE_TAG:-v0.0.0-test}"
        fi
        exit 0
        ;;
    *".claude-plugin/marketplace.json")
        if [ -n "${MOCK_CURL_FIXTURE:-}" ] && [ -f "$MOCK_CURL_FIXTURE" ]; then
            cat "$MOCK_CURL_FIXTURE"
            exit 0
        fi
        ;;
    *"scripts/install.sh")
        if [ -n "${INSTALL_SH:-}" ] && [ -f "$INSTALL_SH" ]; then
            cat "$INSTALL_SH"
            exit 0
        fi
        ;;
esac

echo "mock curl: no fixture for $url" >&2
exit 22
